{
  "$comment": "Effect LS v4 diagnostics ratchet. Enforces the sf-effect baseline plus the diagnostics only supported for Effect v4. Diagnostics disabled by default are enabled as errors in each tsconfig.",
  "enforcedRules": [
    "lazyPromiseInEffectSync",
    "runEffectInsideEffect",
    "globalErrorInEffectFailure",
    "globalErrorInEffectCatch",
    "catchUnfailableEffect",
    "tryCatchInEffectGen",
    "unknownInEffectCatch",
    "effectSucceedWithVoid",
    "unnecessaryFailYieldableError",
    "effectFnIife",
    "unnecessaryEffectGen",
    "unnecessaryPipeChain",
    "returnEffectInGen",
    "floatingEffect",
    "globalRandom",
    "globalRandomInEffect",
    "globalFetchInEffect",
    "globalTimersInEffect",
    "missedPipeableOpportunity",
    "outdatedApi",
    "cryptoRandomUUID",
    "cryptoRandomUUIDInEffect",
    "serviceNotAsClass",
    "anyUnknownInErrorContext",
    "deterministicKeys",
    "effectDoNotation",
    "extendsNativeError",
    "globalConsole",
    "globalConsoleInEffect",
    "globalDate",
    "globalDateInEffect",
    "globalFetch",
    "globalTimers",
    "importFromBarrel",
    "instanceOfSchema",
    "nestedEffectGenYield",
    "newPromise",
    "preferSchemaOverJson",
    "processEnvInEffect",
    "strictEffectProvide",
    "unnecessaryArrowBlock",
    "unsafeEffectTypeAssertion"
  ]
}
