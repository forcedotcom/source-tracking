    "gitdir",
    "Idem",
    "iglite",
    "Integ",
    "iso",
    "isogit",
    "memfs",
    "Millis",
    "mtime",
    "nondelete",
    "noreply",
    "Nsec",
    "Oid",
    "oids",
    "porcelain",
    "posix",
    "Reentrancy",
    "Repro",
    "repos",
    "repros",
    "sfdx",
    "sha",
    "sobject",
    "STL",
    "untr",
    "untracked",
    "uname",
    "vscode",
    "wireit",
    "workdir"
